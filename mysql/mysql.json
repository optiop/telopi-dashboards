    {
      "id": 5,
      "type": "stat",
      "title": "Most connections used",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "description": "The highest share of max_connections in use on any selected server.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "max(100 * max by (cluster, instance) (mysql_global_status_threads_connected{cluster=~\"$environment\", instance=~\"$instance\"}) / max by (cluster, instance) (mysql_global_variables_max_connections{cluster=~\"$environment\", instance=~\"$instance\"}))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#fb923c",
                "value": 70
              },
              {
                "color": "#f87171",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
