          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "count(max by (cluster, instance) (mysql_up{cluster=~\"$environment\", instance=~\"$instance\"}) == 0)",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
