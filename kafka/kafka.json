      "type": "stat",
      "title": "Brokers",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "description": "Brokers in the selected clusters, as the cluster's metadata lists them.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum(max by (cluster, instance) (kafka_brokers{cluster=~\"$environment\", instance=~\"$instance\"}))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
