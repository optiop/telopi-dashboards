{
  "uid": "telopi-nodejs",
  "title": "Node.js",
  "description": "Event loop lag, heap, garbage collection, handles and CPU of each Node.js process that serves prom-client's default metrics, in each environment.",
  "tags": [
    "telopi",
    "nodejs"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "telopi"
      ],
      "asDropdown": true,
      "title": "Telopi dashboards",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "description": "An environment is a Kubernetes cluster, or any machines, that send to this Grafana under one name: the cluster label Alloy sets. Series without one show under All.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gaas-mimir"
        },
        "query": {
          "query": "label_values(nodejs_version_info, cluster)",
          "refId": "environment",
          "qryType": 1
        },
        "definition": "label_values(nodejs_version_info, cluster)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "instance",
        "label": "Process",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gaas-mimir"
        },
        "query": {
          "query": "label_values(nodejs_version_info{cluster=~\"$environment\"}, instance)",
          "refId": "instance",
          "qryType": 1
        },
        "definition": "label_values(nodejs_version_info{cluster=~\"$environment\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Processes up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "description": "Processes Alloy could scrape at the last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "count(min by (cluster, instance) (up{cluster=~\"$environment\", instance=~\"$instance\", job=\"integrations/nodejs\"}) == 1)",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4e80ee",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Processes down",
      "gridPos": {
