      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "count(min by (cluster, instance) (up{cluster=~\"$environment\", instance=~\"$instance\", job=\"integrations/nodejs\"}) == 0)",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
