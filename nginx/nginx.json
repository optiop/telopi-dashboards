{
  "uid": "telopi-nginx",
  "title": "Nginx",
  "description": "Requests and connections of each Nginx, from its stub_status page through the NGINX Prometheus exporter, in each environment.",
  "tags": [
    "telopi",
    "nginx"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "telopi"
      ],
      "asDropdown": true,
      "title": "Telopi dashboards",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "datasource": {
          "type": "loki",
          "uid": "gaas-loki"
        },
        "expr": "{service_name=\"telopi-deploys\", environment=~\"$environment\"} | json",
        "titleFormat": "{{service}} {{status}}",
        "textFormat": "{{title}}",
        "tagKeys": "provider,environment,version",
        "instant": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "description": "An environment is a Kubernetes cluster, or any machines, that send to this Grafana under one name: the cluster label Alloy sets. Series without one show under All.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gaas-mimir"
        },
        "query": {
          "query": "label_values(nginx_up, cluster)",
          "refId": "environment",
          "qryType": 1
        },
        "definition": "label_values(nginx_up, cluster)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "instance",
        "label": "Nginx",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gaas-mimir"
        },
        "query": {
          "query": "label_values(nginx_up{cluster=~\"$environment\"}, instance)",
          "refId": "instance",
          "qryType": 1
        },
        "definition": "label_values(nginx_up{cluster=~\"$environment\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nginx up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "description": "Nginx servers whose stub_status the exporter could read at the last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "count(max by (cluster, instance) (nginx_up{cluster=~\"$environment\", instance=~\"$instance\"}) == 1)",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4e80ee",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nginx down",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "description": "Nginx servers whose stub_status the exporter could not read at the last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "count(max by (cluster, instance) (nginx_up{cluster=~\"$environment\", instance=~\"$instance\"}) == 0)",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#f87171",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "description": "Requests per second, all selected servers.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum(rate(nginx_http_requests_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4e80ee",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active connections",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "description": "Open client connections, including idle keep-alive ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum(nginx_connections_active{cluster=~\"$environment\", instance=~\"$instance\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4e80ee",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Dropped connections",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "description": "Connections accepted but not handled over the time range: Nginx ran out of worker_connections or another limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum(increase(nginx_connections_accepted{cluster=~\"$environment\", instance=~\"$instance\"}[$__range])) - sum(increase(nginx_connections_handled{cluster=~\"$environment\", instance=~\"$instance\"}[$__range]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#f87171",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "description": "Requests per second, per server.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(nginx_http_requests_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests per connection",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "description": "Requests each connection carries on average. Near 1 means clients do not keep connections alive.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(nginx_http_requests_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval])) / sum by (cluster, instance) (rate(nginx_connections_handled{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Connections",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connections by state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "description": "Open connections: reading a request, writing a response, or idle keep-alive (waiting).",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (nginx_connections_reading{cluster=~\"$environment\", instance=~\"$instance\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} reading"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (nginx_connections_writing{cluster=~\"$environment\", instance=~\"$instance\"})",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} writing"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (nginx_connections_waiting{cluster=~\"$environment\", instance=~\"$instance\"})",
          "refId": "C",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} waiting"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Accepted and handled",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "description": "New connections per second. Handled below accepted means connections were dropped.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(nginx_connections_accepted{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} accepted"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(nginx_connections_handled{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} handled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
