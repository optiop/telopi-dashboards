            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Evicted and expired keys",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "description": "Keys removed per second: evicted because memory was full, or expired by their TTL.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(redis_evicted_keys_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} evicted"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(redis_expired_keys_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} expired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
