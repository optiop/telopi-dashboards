    {
      "id": 9,
      "type": "timeseries",
      "title": "Messages per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "description": "Messages published to, delivered from and acknowledged on each node, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(rabbitmq_global_messages_received_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} published"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(rabbitmq_global_messages_delivered_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} delivered"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(rabbitmq_global_messages_acknowledged_total{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "C",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} acknowledged"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
