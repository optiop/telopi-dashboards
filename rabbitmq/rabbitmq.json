          "expr": "sum(rabbitmq_alarms_memory_used_watermark{cluster=~\"$environment\", instance=~\"$instance\"}) + sum(rabbitmq_alarms_free_disk_space_watermark{cluster=~\"$environment\", instance=~\"$instance\"})",
          "refId": "A",
          "instant": false,
          "range": true,
