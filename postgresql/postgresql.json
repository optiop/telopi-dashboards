        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Connections by state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "description": "Open connections per server, by what they are doing. Many idle in transaction ones hold locks and block vacuum.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance, state) (pg_stat_activity_count{cluster=~\"$environment\", instance=~\"$instance\", state!~\"disabled|fastpath function call\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Connections used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "description": "Share of max_connections in use per server. At 100% new connections are refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "100 * sum by (cluster, instance) (pg_stat_activity_count{cluster=~\"$environment\", instance=~\"$instance\"}) / max by (cluster, instance) (pg_settings_max_connections{cluster=~\"$environment\", instance=~\"$instance\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Transactions",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "description": "Committed and rolled back transactions per second, per server.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(pg_stat_database_xact_commit{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} commits"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(pg_stat_database_xact_rollback{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Rows",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "description": "Rows read and written per second, per server.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(pg_stat_database_tup_fetched{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} fetched"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(pg_stat_database_tup_inserted{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} inserted"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(pg_stat_database_tup_updated{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "C",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} updated"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance) (rate(pg_stat_database_tup_deleted{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval]))",
          "refId": "D",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} deleted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "custom": {
