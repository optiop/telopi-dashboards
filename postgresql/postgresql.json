        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "description": "Share of block reads served from shared buffers, per database. Under about 99% on a busy database, shared_buffers or memory may be too small.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum by (cluster, instance, datname) (rate(pg_stat_database_blks_hit{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval])) / (sum by (cluster, instance, datname) (rate(pg_stat_database_blks_hit{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval])) + sum by (cluster, instance, datname) (rate(pg_stat_database_blks_read{cluster=~\"$environment\", instance=~\"$instance\"}[$__rate_interval])))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m",
          "legendFormat": "{{instance}} {{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4,
            "spanNulls": true,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
