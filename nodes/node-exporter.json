      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "max(100 * (1 - max by (cluster, instance, mountpoint) (node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|autofs|fuse.*|devtmpfs\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}) / max by (cluster, instance, mountpoint) (node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|autofs|fuse.*|devtmpfs\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"})))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
