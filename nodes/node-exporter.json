      "title": "Fullest memory",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "description": "The highest share of memory in use, of any selected machine.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "max(100 * (1 - max by (cluster, instance) (node_memory_MemAvailable_bytes{cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}) / max by (cluster, instance) (node_memory_MemTotal_bytes{cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"})))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#fb923c",
                "value": 70
              },
              {
                "color": "#f87171",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
