    {
      "id": 6,
      "type": "stat",
      "title": "Fullest disk",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "description": "The fullest real filesystem of any selected machine.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
