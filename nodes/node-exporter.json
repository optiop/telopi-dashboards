    {
      "id": 8,
      "type": "table",
      "title": "Machines",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "description": "Each machine now. CPU busy is over the last five minutes; memory used is total minus what the kernel says is available. Environment is empty for a machine whose Alloy sets no cluster label.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "time() - max by (cluster, instance) (node_boot_time_seconds{cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "count by (cluster, instance) (node_cpu_seconds_total{mode=\"idle\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "max by (cluster, instance) (node_memory_MemTotal_bytes{cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "100 * (1 - avg by (cluster, instance) (rate(node_cpu_seconds_total{mode=\"idle\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}[5m])))",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "100 * (1 - max by (cluster, instance) (node_memory_MemAvailable_bytes{cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}) / max by (cluster, instance) (node_memory_MemTotal_bytes{cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}))",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "100 * (1 - max by (cluster, instance) (node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|autofs|fuse.*|devtmpfs\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}) / max by (cluster, instance) (node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|autofs|fuse.*|devtmpfs\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}))",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
