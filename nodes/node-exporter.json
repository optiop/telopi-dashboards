    {
      "id": 7,
      "type": "stat",
      "title": "Network in and out",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "description": "Bits a second through physical interfaces, all selected machines.",
      "datasource": {
        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cali.*|flannel.*|cni.*|docker.*|br-.*|virbr.*|tunl.*|vxlan.*|kube-ipvs.*|lxc.*|gke.*|eni.*|azv.*\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|cali.*|flannel.*|cni.*|docker.*|br-.*|virbr.*|tunl.*|vxlan.*|kube-ipvs.*|lxc.*|gke.*|eni.*|azv.*\", cluster=~\"$environment\", job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 8",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
