// Kafka: brokers, topics, partitions, replication and consumer group lag of
// one Kafka cluster, through Alloy's built-in kafka exporter, sent to your
// Telopi stack every minute. Your ingest key's password is read from the
// environment variable TELOPI_PASSWORD.

prometheus.exporter.kafka "kafka" {
  // Any broker of the cluster; the exporter finds the others.
  kafka_uris = ["${KAFKA_ADDRESS}"]
}

prometheus.scrape "kafka" {
  targets         = prometheus.exporter.kafka.kafka.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.kafka.receiver]
}

prometheus.remote_write "kafka" {
  // The environment's name: the Kafka dashboard and its alerts group by it.
  external_labels = {
    cluster = "${ENVIRONMENT}",
  }

  endpoint {
    url = "${INGEST_URL}/mimir/api/v1/push"

    basic_auth {
      username = "${USERNAME}"
      password = sys.env("TELOPI_PASSWORD")
    }
  }
}
