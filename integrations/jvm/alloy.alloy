// JVM: heap and other memory, garbage collection, threads and CPU of one
// Java (or Kotlin, Scala, ...) process, from the Prometheus JMX exporter
// running in it as a Java agent, scraped by Alloy and sent to your Telopi
// stack every minute. Your ingest key's password is read from the
// environment variable TELOPI_PASSWORD.

prometheus.scrape "jvm" {
  targets = [{
    __address__ = "${JVM_ADDRESS}",
  }]
  // The job the JVM dashboard and alerts read the process's up from.
  job_name        = "integrations/jvm"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.jvm.receiver]
}

prometheus.remote_write "jvm" {
  // The environment's name: the JVM dashboard and its alerts group by it.
  external_labels = {
    cluster = "${ENVIRONMENT}",
  }

  endpoint {
    url = "${INGEST_URL}/mimir/api/v1/push"

    basic_auth {
      username = "${USERNAME}"
      password = sys.env("TELOPI_PASSWORD")
    }
  }
}
