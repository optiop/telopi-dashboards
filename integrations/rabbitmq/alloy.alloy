// RabbitMQ: queues, messages, connections, memory and disk of one RabbitMQ
// node, from its built-in Prometheus plugin, scraped by Alloy and sent to
// your Telopi stack every minute. Your ingest key's password is read from the
// environment variable TELOPI_PASSWORD.

prometheus.scrape "rabbitmq" {
  targets = [{
    __address__ = "${RABBITMQ_ADDRESS}",
  }]
  // The job the RabbitMQ dashboard and alerts read the node's up from.
  job_name        = "integrations/rabbitmq"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.rabbitmq.receiver]
}

prometheus.remote_write "rabbitmq" {
  // The environment's name: the RabbitMQ dashboard and its alerts group by it.
  external_labels = {
    cluster = "${ENVIRONMENT}",
  }

  endpoint {
    url = "${INGEST_URL}/mimir/api/v1/push"

    basic_auth {
      username = "${USERNAME}"
      password = sys.env("TELOPI_PASSWORD")
    }
  }
}
