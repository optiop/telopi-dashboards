// MySQL: connections, queries, InnoDB and replication of one MySQL or
// MariaDB, through Alloy's built-in mysql exporter, sent to your Telopi stack
// every minute. The connection string, with its password, is read from the
// environment variable MYSQL_DSN; your ingest key's password from
// TELOPI_PASSWORD.

prometheus.exporter.mysql "mysql" {
  data_source_name = sys.env("MYSQL_DSN")
}

// A target on this machine (localhost) is named after the machine and its
// port, so machines of one environment stay apart.
discovery.relabel "mysql" {
  targets = prometheus.exporter.mysql.mysql.targets

  rule {
    source_labels = ["instance"]
    regex         = "(?:[a-z]+://|tcp\\()?(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?.*"
    target_label  = "instance"
    replacement   = constants.hostname + "$1"
  }
}

prometheus.scrape "mysql" {
  targets         = discovery.relabel.mysql.output
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.mysql.receiver]
}

// Only what the dashboard, its alerts and the tile's check read:
// the exporter sends several hundred status variables besides.
prometheus.relabel "mysql" {
  forward_to = [prometheus.remote_write.mysql.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "mysql_global_status_aborted_clients|mysql_global_status_aborted_connects|mysql_global_status_bytes_received|mysql_global_status_bytes_sent|mysql_global_status_commands_total|mysql_global_status_created_tmp_disk_tables|mysql_global_status_innodb_buffer_pool_bytes_data|mysql_global_status_innodb_buffer_pool_read_requests|mysql_global_status_innodb_buffer_pool_reads|mysql_global_status_innodb_row_ops_total|mysql_global_status_queries|mysql_global_status_slow_queries|mysql_global_status_threads_connected|mysql_global_status_threads_running|mysql_global_variables_innodb_buffer_pool_size|mysql_global_variables_max_connections|mysql_slave_status_replica_io_running|mysql_slave_status_replica_sql_running|mysql_slave_status_seconds_behind_master|mysql_slave_status_seconds_behind_source|mysql_slave_status_slave_io_running|mysql_slave_status_slave_sql_running|mysql_up"
    action        = "keep"
  }
}

prometheus.remote_write "mysql" {
  // The environment's name: the MySQL dashboard and its alerts group by it.
  external_labels = {
    cluster = "${ENVIRONMENT}",
  }

  endpoint {
    url = "${INGEST_URL}/mimir/api/v1/push"

    basic_auth {
      username = "${USERNAME}"
      password = sys.env("TELOPI_PASSWORD")
    }
  }
}
