// MySQL: connections, queries, InnoDB and replication of one MySQL or
// MariaDB, through Alloy's built-in mysql exporter, sent to your Telopi stack
// every minute. The connection string, with its password, is read from the
// environment variable MYSQL_DSN; your ingest key's password from
// TELOPI_PASSWORD.

prometheus.exporter.mysql "mysql" {
  data_source_name = sys.env("MYSQL_DSN")
}

prometheus.scrape "mysql" {
  targets         = prometheus.exporter.mysql.mysql.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.mysql.receiver]
}

prometheus.remote_write "mysql" {
  // The environment's name: the MySQL dashboard and its alerts group by it.
  external_labels = {
    cluster = "${ENVIRONMENT}",
  }

  endpoint {
    url = "${INGEST_URL}/mimir/api/v1/push"

    basic_auth {
      username = "${USERNAME}"
      password = sys.env("TELOPI_PASSWORD")
    }
  }
}
