    {
      "id": 6,
      "type": "stat",
      "title": "Median page load",
      "description": "Half of all page loads finished faster than this.",
      "datasource": {
        "type": "loki",
        "uid": "gaas-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "gaas-loki"
          },
          "expr": "quantile_over_time(0.5, {source=\"faro\"} |= \"faro.performance.navigation\" | logfmt | event_name=\"faro.performance.navigation\" | unwrap event_data_pageLoadTime | __error__=\"\" [$__range]) by ()",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22c55e",
                "value": null
              },
              {
                "color": "#fb923c",
                "value": 2500
              },
              {
                "color": "#f87171",
                "value": 5000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Sessions from AI assistants",
      "description": "Sessions that began with a link from an AI assistant such as ChatGPT or Perplexity. The assistants' own crawlers do not run JavaScript and are not counted here.",
      "datasource": {
        "type": "loki",
        "uid": "gaas-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "gaas-loki"
          },
          "expr": "count(sum by (session_id) (count_over_time({source=\"faro\"} |= \"event_name=referrer\" | logfmt | event_name=\"referrer\" | event_data_host=~\"(.+\\\\.)?(chatgpt\\\\.com|openai\\\\.com|perplexity\\\\.ai|claude\\\\.ai|gemini\\\\.google\\\\.com|copilot\\\\.microsoft\\\\.com|you\\\\.com|phind\\\\.com|deepseek\\\\.com|meta\\\\.ai)\" [$__range]))) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
