{
  "uid": "gaas-website",
  "title": "Website",
  "description": "What visitors' browsers report about this website: traffic, speed, errors. Sent by the Grafana Faro Web SDK snippet on the site's pages.",
  "tags": [
    "telopi",
    "gaas",
    "website"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Page loads",
      "description": "Full page loads in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "gaas-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "gaas-loki"
          },
          "expr": "sum(count_over_time({source=\"faro\"} |= \"faro.performance.navigation\" | logfmt | event_name=\"faro.performance.navigation\" [$__interval]))",
          "refId": "A",
          "queryType": "instant",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4e80ee",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sessions",
      "description": "Distinct browser sessions. A session is one browser tab: the same person in two tabs, or coming back hours later, counts as more than one.",
      "datasource": {
        "type": "loki",
        "uid": "gaas-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "gaas-loki"
          },
          "expr": "count(sum by (session_id) (count_over_time({source=\"faro\"} | logfmt | session_id!=\"\" [$__range]))) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
