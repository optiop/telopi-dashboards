        "type": "prometheus",
        "uid": "gaas-mimir"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "gaas-mimir"
          },
          "expr": "max(100 * sum by (cluster, instance) (rate(jvm_gc_collection_seconds_sum{cluster=~\"$environment\", instance=~\"$instance\", gc!~\".*(Concurrent|Cycles).*\"}[$__rate_interval])))",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
