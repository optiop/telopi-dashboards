{
  "uid": "telopi-jvm",
  "title": "JVM",
  "description": "Heap and other memory, garbage collection, threads and CPU of each Java process that runs the Prometheus JMX exporter's agent, in each environment.",
  "tags": [
    "telopi",
    "jvm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "telopi"
      ],
      "asDropdown": true,
      "title": "Telopi dashboards",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "description": "An environment is a Kubernetes cluster, or any machines, that send to this Grafana under one name: the cluster label Alloy sets. Series without one show under All.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gaas-mimir"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes, cluster)",
          "refId": "environment",
          "qryType": 1
        },
        "definition": "label_values(jvm_memory_used_bytes, cluster)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "instance",
        "label": "Process",
        "description": "",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gaas-mimir"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes{cluster=~\"$environment\"}, instance)",
          "refId": "instance",
          "qryType": 1
        },
        "definition": "label_values(jvm_memory_used_bytes{cluster=~\"$environment\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
